# ─────────────────────────────────────────────────────────────────────────────
# Arquivo de configuração para a VM de desenvolvimento.
# Copie este arquivo como .env e preencha os valores marcados com <...>
# ─────────────────────────────────────────────────────────────────────────────

# Django — gerar chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<GERAR_CHAVE_SEGURA>
DEBUG=False
ALLOWED_HOSTS=<IP_DA_VM>,localhost,127.0.0.1

# PostgreSQL
DB_NAME=sis_bem_estar
DB_USER=postgres
DB_PASSWORD=<SENHA_FORTE>
DB_HOST=db
DB_PORT=5432

# Email — SMTP interno AEB (relay sem autenticação)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.aeb.gov.br
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@aeb.gov.br

# Destinatário do disparo de e-mails do evento (Lista de Distribuição em produção)
EMAIL_DESTINO_EVENTO=<ld-bem-estar@aeb.gov.br>

# URL base do frontend — usada nos links dos e-mails enviados pelo backend
FRONTEND_URL=http://<IP_DA_VM>

# CORS — permitir o frontend acessar a API
CORS_ALLOWED_ORIGINS=http://<IP_DA_VM>

# Redis
REDIS_URL=redis://redis:6379/0

# URL da API usada pelo frontend no build (injetada no Vite em tempo de build)
VITE_API_URL=http://<IP_DA_VM>/api

# LDAP / Active Directory
# mock  → usa lista local (desenvolvimento sem acesso ao AD)
# ldap  → busca real no Active Directory da AEB
USUARIO_BUSCA_BACKEND=ldap
LDAP_HOST=ldap.aeb.gov.br
LDAP_PORT=389
LDAP_BIND_DN=CN=Eventos Dev,OU=SERVICO,OU=USUARIOS,OU=AEB,DC=aeb,DC=gov,DC=br
LDAP_BIND_PASSWORD=<SENHA_DO_SERVICE_ACCOUNT>
LDAP_BASE_DN=OU=USUARIOS,OU=AEB,DC=aeb,DC=gov,DC=br

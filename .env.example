SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Documentacao OpenAPI/Swagger.
# Em producao com DEBUG=False, deixe False salvo se for expor atras de VPN/proxy protegido.
API_DOCS_ENABLED=True

# Limites contra abuso em rotas publicas de login, OTP e leitura publica.
PUBLIC_AUTH_THROTTLE_RATE=20/minute
PUBLIC_READ_THROTTLE_RATE=60/minute

# PostgreSQL
DB_NAME=sis_bem_estar
DB_USER=postgres
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=5432

# Email (use console para dev, configure SMTP em produção)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Agenda Bem-Estar <noreply@empresa.com.br>

# URL base do frontend (usada nos links dos e-mails)
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
